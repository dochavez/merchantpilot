# Copy to .env.local and fill in. Everything is optional: with no keys the app runs on demo data.

# --- PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the same app (Webhooks section) to verify webhook signatures
PAYPAL_WEBHOOK_ID=
MERCHANT_NAME=Altura Coffee Supply (sandbox)
# 1 = use built-in demo data even if PayPal keys are set
FORCE_DEMO=0

# --- AI model: set ONE of these (OpenAI is used if both are set, unless LLM_PROVIDER says otherwise)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# openai | anthropic | mock   (mock = scripted model for tests, no key needed)
LLM_PROVIDER=
# Optional model override, e.g. gpt-5-mini, gpt-5, claude-sonnet-4-5
LLM_MODEL=

# --- AG Studio trial license (removes the watermark). Request at ag-grid.com/studio/license-pricing
NEXT_PUBLIC_AG_STUDIO_LICENSE_KEY=

# --- Optional: Postgres for the audit trail and approval rules (Render sets this from render.yaml)
DATABASE_URL=

# --- Morning brief: secret for signed approve links, and optional daily email via Resend
BRIEF_SIGNING_SECRET=
APP_URL=
CRON_SECRET=
RESEND_API_KEY=
BRIEF_EMAIL_TO=

# --- Optional: protect the Power BI / Excel OData feed and export URLs (Basic auth password or ?key=)
EXPORT_API_KEY=

# --- Seed script only: a sandbox test card from developer.paypal.com → Testing tools → Card generator
SANDBOX_CARD_NUMBER=
SANDBOX_CARD_EXPIRY=2030-12
SANDBOX_CARD_CVV=123
